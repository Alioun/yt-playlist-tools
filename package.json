{
  "packageManager": "bun@1.4.3",
  "name": "yt-playlist-tools",
  "displayName": "YouTube Playlist Tools",
  "version": "1.5.0",
  "description": "Add current YouTube video to specified playlists.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:beta": "wxt build -b firefox --mode beta",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:beta": "wxt zip -b firefox --mode beta",
    "compile": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "oxlint src tests tools scripts build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun run test:bun && bun run test:fixtures",
    "postinstall": "wxt prepare",
    "test:bun": "bun run scripts/run-bun-tests.ts",
    "test:fixtures": "bun run scripts/run-fixture-gates.ts",
    "check:manifest": "bun scripts/check-manifest.ts .output/chrome-mv3 .output/firefox-mv3",
    "check:utf8": "bun scripts/check-utf8.ts .output/chrome-mv3 .output/firefox-mv3",
    "check:budget": "bun scripts/check-budget.ts .output/chrome-mv3 .output/firefox-mv3",
    "build:pilot": "wxt build tools/fixtures/svelte-pilot",
    "build:pilot:firefox": "wxt build tools/fixtures/svelte-pilot -b firefox",
    "typecheck:pilot": "node tools/fixtures/svelte-pilot/typecheck.mjs",
    "check:pilot": "node tools/fixtures/svelte-pilot/check-build.mjs",
    "test:pilot:browser": "node tools/fixtures/svelte-pilot/check-browser.mjs"
  },
  "dependencies": {
    "@webext-core/isolated-element": "3.0.0",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.4.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@wxt-dev/module-svelte": "2.0.5",
    "bits-ui": "2.20.2",
    "happy-dom": "^21.0.4",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "1.64.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "tailwindcss": "^4.1.14",
    "typescript": "~7.0.2",
    "typescript6": "npm:typescript@6.0.3",
    "vite": "8.3.6",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
