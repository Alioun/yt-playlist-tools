{
  "packageManager": "bun@1.4.3",
  "name": "yt-playlist-tools",
  "displayName": "YouTube Playlist Tools",
  "version": "1.5.0",
  "description": "Add current YouTube video to specified playlists.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:beta": "wxt build -b firefox --mode beta",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:beta": "wxt zip -b firefox --mode beta",
    "compile": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "bun run test:legacy && bun run test:bun",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "wxt prepare",
    "test:legacy": "vitest run",
    "test:bun": "bun run scripts/run-bun-tests.ts",
    "build:pilot": "wxt build tools/fixtures/svelte-pilot",
    "build:pilot:firefox": "wxt build tools/fixtures/svelte-pilot -b firefox",
    "typecheck:pilot": "node tools/fixtures/svelte-pilot/typecheck.mjs",
    "check:pilot": "node tools/fixtures/svelte-pilot/check-build.mjs",
    "test:pilot:browser": "node tools/fixtures/svelte-pilot/check-browser.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.4",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "4.22.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-react": "^1.2.2",
    "@wxt-dev/module-svelte": "2.0.5",
    "bits-ui": "2.19.5",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "playwright": "1.64.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.4"
  }
}
