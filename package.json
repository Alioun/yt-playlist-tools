{
  "packageManager": "bun@1.3.4",
  "name": "yt-playlist-tools",
  "displayName": "YouTube Playlist Tools",
  "version": "1.5.0",
  "description": "Add current YouTube video to specified playlists.",
  "scripts": {
    "dev": "plasmo dev",
    "dev:firefox": "plasmo dev --target=firefox-mv3",
    "build": "plasmo build",
    "build:firefox": "plasmo build --target=firefox-mv3",
    "package": "plasmo package",
    "package:firefox": "plasmo package --target=firefox-mv3",
    "server": "bun run server/index.ts",
    "server:dev": "bun --watch run server/index.ts"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "plasmo": "^0.90.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/chrome": "^0.1.38",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "npm": "^11.12.0",
    "postcss": "^8.5.8",
    "tailwindcss": "3",
    "typescript": "^6.0.2"
  },
  "manifest": {
    "permissions": [
      "activeTab",
      "storage",
      "identity",
      "scripting"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "{cc70cd21-2cc6-444b-bd89-496909346091}",
        "strict_min_version": "125.0"
      }
    }
  }
}
