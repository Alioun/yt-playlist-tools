{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["svelte", "vite/client", "chrome"],
    "baseUrl": ".",
    "paths": { "$kit": ["./src/site/kit/index.ts"] }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"]
}
