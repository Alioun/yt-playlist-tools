# Copy to server/.env and replace every "replace-me".
# Placeholders cause "Error 401: invalid_client" at sign-in.

# Google OAuth client, type "Web application".
# Console: enable YouTube Data API v3, add scope youtube.force-ssl, create the client.
# Add both redirect URIs from Settings > Advanced in the extension.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# Comma-separated extension IDs allowed to use this broker.
# Chrome: extension ID. Firefox: the sha1 in the mozoauth2 redirect URI.
# Empty allows any extension (fine locally).
ALLOWED_EXTENSION_IDS=

# The compose files publish 3847 regardless of this value.
PORT=3847
