# Token broker configuration. Copy to server/.env and replace the placeholders:
#
#   cp server/.env.example server/.env
#
# Both `bun run server` and `docker compose -f server/docker-compose.dev.yml up`
# read it from there. The file is gitignored and excluded from the Docker image.
#
# EVERY value below saying "replace-me" must actually be replaced. Leaving them
# starts the broker fine -- it does not validate them -- and then fails the
# moment you click "Sign in with Google", because the placeholder is handed to
# Google verbatim:
#
#   Access blocked: Authorization Error
#   The OAuth client was not found.
#   Error 401: invalid_client
#
# That error always means Google did not recognise GOOGLE_CLIENT_ID.


# -- Required -------------------------------------------------------------
# Credentials for a Google OAuth client of type "Web application" -- the only
# type with a redirect URI field, which a browser extension needs.
#
# Google Cloud Console -> APIs & Services:
#   1. Library              -> enable "YouTube Data API v3"
#   2. OAuth consent screen -> External, add the scope
#                              https://www.googleapis.com/auth/youtube.force-ssl
#   3. Credentials          -> Create Credentials -> OAuth 2.0 Client ID
#                           -> Application type: Web application
#
# The ID looks like 1234567890-abc123def456.apps.googleusercontent.com and the
# secret like GOCSPX-xxxxxxxxxxxxxxxxxxxx. Neither is a value you invent.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# On that same client, add BOTH of these under "Authorized redirect URIs":
#   https://<chrome-extension-id>.chromiumapp.org/
#   http://127.0.0.1/mozoauth2/<sha1-of-firefox-extension-id>
# Do not construct them by hand -- open the extension's settings, expand
# Advanced, and copy the "Redirect URI" it prints for the browser you are in.
# Google matches these byte for byte, so a missing or extra trailing slash
# fails with redirect_uri_mismatch (a different error from invalid_client).


# -- Recommended ----------------------------------------------------------
# Comma-separated extension ids this broker will exchange tokens for.
#   Chrome:  the extension id, e.g. mkjfooclpclccnlkbcaeflcgmhpbjmoi
#   Firefox: the sha1 shown in the mozoauth2 redirect URI above, NOT the
#            {uuid} from the manifest.
#
# Empty means any extension can spend your Google client's quota and its
# consent-screen reputation; the broker warns at startup when it is. Fine to
# leave empty locally -- an unpacked extension's id changes per browser
# profile, so pinning it would mean editing this after every fresh load.
ALLOWED_EXTENSION_IDS=


# -- Optional -------------------------------------------------------------
# Port the broker listens on. 3847 is what the extension expects unless you
# change WXT_AUTH_SERVER_URL (see .env.example at the repo root) or set a Token
# server URL in the extension's Advanced settings. Note the compose files
# publish 3847 explicitly, so changing this alone will not move that port.
PORT=3847
