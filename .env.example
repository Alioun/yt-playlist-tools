# Build-time configuration for the extension. Copy to .env at the repo root:
#
#   cp .env.example .env
#
# WXT only exposes variables prefixed WXT_ to extension code, and inlines them
# at build time -- a change here needs a rebuild, not just a reload.
#
# Nothing here is required. Every value has a working default, and the broker
# URL can also be set at runtime (see below), so a plain `bun run dev` works
# with no .env at all.


# Default URL of the token broker (server/index.ts).
# Defaults to http://localhost:3847, which matches server/.env.example's PORT
# and the port both compose files publish.
#
# This affects only builds you make yourself. Anyone running a published build
# can override it at runtime in the extension's settings -> Advanced -> Token
# server, and that takes precedence over whatever is set here.
WXT_AUTH_SERVER_URL=http://localhost:3847


# Not configured here, for reference:
#
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / ALLOWED_EXTENSION_IDS / PORT
#     belong to the broker, not the extension -- see server/.env.example.
#     The extension deliberately ships no Google credentials.
#
#   CHROME_* / FIREFOX_* store-submission credentials
#     see .env.submit.example.
