{
 "boundary": {
  "cwd": "{qualificationSource}",
  "environment": "cleared with env -i; only HOME TMPDIR PATH",
  "stdin": "/dev/null",
  "Bun": "every invocation requires --no-env-file --no-install; no bunx or install-capable helper",
  "network": "none",
  "enforcement": "BLOCKED until a later sole lease proves environment-file refusal, PATH pinning, closed stdin, descendants and deadlines"
 },
