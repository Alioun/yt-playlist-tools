    "/usr/bin/env",
    "-i",
    "HOME={qualificationScratch}/home",
    "TMPDIR={qualificationScratch}/tmp",
    "PATH={pinnedExecutableBin}:{qualifiedDependencies}/.bin:/usr/bin:/bin",
    "/usr/bin/timeout",
    "-k",
    "10",
    "120",
    "{qualifiedDependencies}/@typescript/typescript-darwin-arm64/lib/tsc",
    "--noEmit",
    "-p",
    "tools/fixtures/site-queue-button/tsconfig.json",
    "--listFiles"
   ],
   "stdin": "/dev/null",
   "output": "bounded: stdout and stderr captured to {qualificationEvidence}/native-positive.log, first 256 KiB retained",
   "requires": [
    "later sole lease",
    "dummy enforcement",
    "pinned dependency root verified against dependency-identities.json"
   ],
   "captureStdout": "{qualificationEvidence}/native-files.txt"
  },
  {
