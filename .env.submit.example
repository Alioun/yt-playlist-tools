# Copy to .env.submit for `bunx wxt submit` (or run `bunx wxt submit init`).
# CI reads the same names from GitHub secrets instead.

# Chrome Web Store. Client/secret/token come from a Google Cloud client with the
# Chrome Web Store API enabled (separate from the YouTube client).
CHROME_EXTENSION_ID=
CHROME_CLIENT_ID=
CHROME_CLIENT_SECRET=
CHROME_REFRESH_TOKEN=

# AMO. JWT pair from addons.mozilla.org > Tools > Manage API Keys.
# The ID must match the gecko ID in wxt.config.ts.
FIREFOX_EXTENSION_ID={cc70cd21-2cc6-444b-bd89-496909346091}
FIREFOX_JWT_ISSUER=
FIREFOX_JWT_SECRET=
