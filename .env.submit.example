# Credentials for `wxt submit`, which uploads the built zips to the Chrome Web
# Store and AMO. Copy to .env.submit at the repo root:
#
#   cp .env.submit.example .env.submit
#
# `bunx wxt submit init` walks through obtaining these interactively and writes
# the same file, if you would rather not gather them by hand.
#
# Only needed to publish from your own machine. CI does not read this file --
# .github/workflows/release.yml passes the same names in from GitHub Actions
# secrets, so add them there under Settings -> Secrets and variables -> Actions
# rather than committing anything. The variable names are WXT's and must match
# exactly.
#
# The release workflow runs:
#   bunx wxt submit --chrome-zip .output/*-chrome.zip \
#                   --firefox-zip .output/*-firefox.zip \
#                   --firefox-sources-zip .output/*-sources.zip
#
# AMO requires that sources zip so reviewers can rebuild; `bun run zip:firefox`
# produces it alongside the extension zip.


# -- Chrome Web Store -----------------------------------------------------
# EXTENSION_ID is from the item's dashboard URL. The other three come from a
# Google Cloud OAuth client with the Chrome Web Store API enabled -- a separate
# client from the YouTube one the broker uses, and not interchangeable with it.
# Google's "Using the Chrome Web Store Publish API" guide covers minting the
# refresh token.
CHROME_EXTENSION_ID=
CHROME_CLIENT_ID=
CHROME_CLIENT_SECRET=
CHROME_REFRESH_TOKEN=


# -- Firefox Add-ons (AMO) ------------------------------------------------
# EXTENSION_ID is the gecko id from wxt.config.ts, braces included:
#   {cc70cd21-2cc6-444b-bd89-496909346091}
# Changing it breaks updates for every existing install, so it must match.
#
# The JWT pair is issued at addons.mozilla.org -> Tools -> Manage API Keys.
# The secret is shown once and cannot be retrieved again.
FIREFOX_EXTENSION_ID={cc70cd21-2cc6-444b-bd89-496909346091}
FIREFOX_JWT_ISSUER=
FIREFOX_JWT_SECRET=
